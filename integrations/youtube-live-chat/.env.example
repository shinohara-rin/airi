# Enable the YouTube Data API v3 in the Google Cloud project that owns this key.
YOUTUBE_API_KEY=
# Use liveStreamingDetails.activeLiveChatId from videos.list, not the video ID.
YOUTUBE_LIVE_CHAT_ID=
# Ignore messages published before this process starts unless explicitly enabled.
YOUTUBE_INCLUDE_HISTORY=false
YOUTUBE_MAX_RETRIES=5
AIRI_WS_URL=ws://localhost:6121/ws
# Uncomment when the AIRI server requires authentication.
# AIRI_TOKEN=
