{
  "name": "@proj-airi/youtube-live-chat",
  "type": "module",
  "private": true,
  "description": "YouTube live chat input for AIRI through server-sdk",
  "license": "MIT",
  "scripts": {
    "generate": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=src/generated --defaults --arrays --objects --oneofs --longs=String --enums=String proto/stream-list.proto",
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "test": "vitest run",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@moeru/std": "catalog:",
    "@proj-airi/server-sdk": "workspace:^",
    "injeca": "catalog:",
    "tsx": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@proj-airi/server-runtime": "workspace:^",
    "@proj-airi/server-shared": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
